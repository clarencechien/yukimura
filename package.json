{
  "name": "sanada-crimson-winter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "models": "blender --background --python-exit-code 1 --python tools/build_models.py",
    "test:e2e": "npm run build && playwright test",
    "models:preview": "blender --background assets/source/samurai-kit.blend --threads 2 --python-exit-code 1 --python tools/render_models.py",
    "build:pages": "npm run build -- --base=/yukimura/",
    "test:pages": "npm run build:pages && playwright test --config playwright.pages.config.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "@playwright/test": "^1.56.0"
  }
}
